{
  "name": "spektly",
  "productName": "Spektly",
  "version": "2.5.3",
  "description": "Local-first scheduler, approval queue, publisher and analytics for YouTube, TikTok, Instagram, Threads, Facebook and X.",
  "main": "main.js",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js test/*.test.mjs",
    "vendor:keygen": "node vendor/keygen.js",
    "vendor:issue": "node vendor/issue.js",
    "vendor:activate": "node vendor/activate.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.spektly.desktop",
    "productName": "Spektly",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "legal/**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSDownloadsFolderUsageDescription": "Spektly removes older copies of itself and old installer files so only the current version stays installed.",
        "NSDesktopFolderUsageDescription": "Spektly removes older copies of itself and old installer files so only the current version stays installed."
      },
      "artifactName": "Spektly-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Spektly",
      "uninstallDisplayName": "Spektly",
      "artifactName": "Spektly-Setup.${ext}",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "asar": true,
    "publish": null,
    "dmg": {
      "background": "build/background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 228,
          "type": "file"
        },
        {
          "x": 390,
          "y": 228,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "iconSize": 96,
      "iconTextSize": 13,
      "title": "Spektly ${version}"
    }
  },
  "updateFeed": "https://spektly.com/updates/latest.json",
  "updateFeedFallback": "https://api.github.com/repos/Dividesby0/creator-hub/releases/latest",
  "downloadBase": "https://spektly.com/download/"
}
