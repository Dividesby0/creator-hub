{
  "name": "spektly",
  "productName": "Spektly",
  "version": "2.4.6",
  "description": "Local-first scheduler, approval queue, publisher and analytics for YouTube, TikTok, Instagram, Threads, Facebook and X.",
  "main": "main.js",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js test/*.test.mjs",
    "vendor:keygen": "node vendor/keygen.js",
    "vendor:issue": "node vendor/issue.js",
    "vendor:activate": "node vendor/activate.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.spektly.desktop",
    "productName": "Spektly",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "legal/**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSDownloadsFolderUsageDescription": "Spektly removes older copies of itself and old installer files so only the current version stays installed.",
        "NSDesktopFolderUsageDescription": "Spektly removes older copies of itself and old installer files so only the current version stays installed."
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Spektly",
      "uninstallDisplayName": "Spektly"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "asar": true,
    "publish": null
  },
  "updateFeed": "https://api.github.com/repos/Dividesby0/creator-hub/releases/latest"
}
